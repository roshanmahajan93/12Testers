# Public (bundled into the app). Copy to .env.local and fill in.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=main
# Optional — only if your Appwrite project has more than one push (FCM) provider.
EXPO_PUBLIC_APPWRITE_FCM_PROVIDER_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=

# Build-time only (app.config.ts) — not bundled. Firebase config for FCM push.
# GOOGLE_SERVICES_JSON=./google-services.json

# Scripts only (setup/seed) — NEVER prefix with EXPO_PUBLIC_.
# APPWRITE_API_KEY=
